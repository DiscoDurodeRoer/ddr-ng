{
  "name": "ddr-ng-documentation",
  "version": "22.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test-library": "ng test ddr-ng-lib --watch false",
    "build-library": "ng build ddr-ng-lib --watch",
    "test-build-library": "npm run test-library && ng build ddr-ng-lib",
    "start-library": "ng serve --watch --port 5200",
    "install-library-local": "ng build ddr-ng-lib && npm i ./dist/ddr-ng",
    "publish": "npm run test-build-library && cd dist && npm publish ddr-ng",
    "build-documentation": "ng build --aot --configuration=production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "ngx-pagination": "^6.0.3",
    "rxjs": "~7.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "~22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jasmine": "^5.1.4",
    "@types/prismjs": "^1.26.5",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.1",
    "prettier": "^3.5.3",
    "prismjs": "^1.30.0",
    "sass": "^1.89.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
